{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "plan",
  "permission": {
    "mcp_*": "ask"
  },
  "agent": {
    "builder": {
      "description": "Implements planned development work with focused, minimal changes.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "high"
      },
      "prompt": "{file:prompts/builder.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "architect": {
      "description": "Reviews genuine architecture decisions and recommends the smallest design that satisfies current requirements.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "prompt": "{file:prompts/architect.txt}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "read": "allow"
      }
    },
    "code-reviewer": {
      "description": "Finding-driven review for broad, risky, or explicitly requested changes.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "prompt": "{file:prompts/code-reviewer.txt}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "read": "allow"
      }
    },
    "security-reviewer": {
      "description": "Threat-model-driven security review and remediation for meaningful attack surfaces.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "prompt": "{file:prompts/security-reviewer.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "webfetch": "allow"
      }
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist. Use when build fails or type errors occur. Fixes build/type errors only with minimal diffs.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:prompts/build-error-resolver.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "refactor-cleaner": {
      "description": "Focused dead-code, unused dependency, and duplicate cleanup with behavior preservation.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:prompts/refactor-cleaner.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "database-reviewer": {
      "description": "Evidence-based PostgreSQL and Prisma review for schema, migration, integrity, security, and query concerns.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:prompts/database-reviewer.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "skeptic": {
      "description": "Simplify implementations using KISS and YAGNI. Eliminate unnecessary abstractions and premature optimization. Prefer existing code and the smallest reasonable solution.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:prompts/skeptic.txt}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow"
      }
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "bun",
        "x",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    },
    "prisma": {
      "type": "local",
      "command": [
        "bun",
        "x",
        "prisma",
        "mcp"
      ],
      "enabled": true
    },
  },
}
